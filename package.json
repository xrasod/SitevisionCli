{
	"name": "sitevision-cli",
	"version": "1.0.0-beta.20",
	"license": "MIT",
	"bin": {
		"svc": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava",
		"release": "./scripts/publish.sh",
		"release:beta": "./scripts/publish-beta.sh"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@napi-rs/keyring": "^1.3.0",
		"ink": "^7.1.0",
		"ink-spinner": "^5.0.0",
		"meow": "^14.1.0",
		"open": "^11.0.3",
		"puppeteer-core": "^25.10.0",
		"react": "^19.2.7"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^8.0.1",
		"eslint-config-xo-react": "^0.30.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.8.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"xo": "^3.0.2"
	},
	"ava": {
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--import=tsx"
		]
	},
	"prettier": "@vdemedes/prettier-config"
}
